# Copy to .env for local development (git-ignored). In GitHub Actions set
# these as repository secrets; on a server, as environment variables.
# Never commit real keys.

# ---- storage ----------------------------------------------------------------
# PostgreSQL in production; leave empty for SQLite at data/macro.db.
MACRO_DATABASE_URL=
MACRO_HISTORY_START=2015-01-01

# ---- data providers (all optional; keyless sources are used otherwise) -------
FRED_API_KEY=            # free: https://fred.stlouisfed.org/docs/api/api_key.html (adds the release calendar)
EIA_API_KEY=             # free: https://www.eia.gov/opendata/
ALPHAVANTAGE_API_KEY=
TRADINGECONOMICS_API_KEY=

# Refinitiv / LSEG Data Platform. An app key ALONE cannot sign in: RDP needs a
# machine account (username + password + app key) or a service account
# (client id + secret). When it works it becomes the first source for every
# bond, FX, equity and OIS series.
REFINITIV_APP_KEY=
REFINITIV_USERNAME=
REFINITIV_PASSWORD=
REFINITIV_CLIENT_ID=
REFINITIV_CLIENT_SECRET=
# The account allows ONE session. If Workspace or another job holds it, the
# client waits and retries; it signs out at the end of every run. Set
# TAKE_SESSION=true only if you accept being signed out of Workspace.
MACRO_REFINITIV_SESSION_RETRIES=4
MACRO_REFINITIV_SESSION_WAIT=60
MACRO_REFINITIV_TAKE_SESSION=false

# ---- commentary --------------------------------------------------------------
ANTHROPIC_API_KEY=       # optional; without it commentary is fully deterministic
ANTHROPIC_MODEL=claude-opus-5-5
MACRO_LLM_ENABLED=true

# ---- runtime -----------------------------------------------------------------
MACRO_DEMO_MODE=false            # true = labelled synthetic data, never mixed with live
MACRO_HTTP_TIMEOUT=30
MACRO_HTTP_RETRIES=4
MACRO_CACHE_TTL_HOURS=6
MACRO_SCHEDULE_HOUR=5            # 05:30 Europe/London, weekdays
MACRO_SCHEDULE_MINUTE=30
MACRO_SCHEDULE_TZ=Europe/London
ALLOWED_ORIGINS=*
MACRO_API_CACHE_SECONDS=60
MACRO_ADMIN_TOKEN=               # enables POST /api/admin/refresh
